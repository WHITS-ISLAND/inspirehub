{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "eqeqeq": "error",
    "no-unused-vars": "warn"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".output",
    "*.config.js",
    "*.config.ts"
  ]
}
