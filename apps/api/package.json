{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --persist-to=./.wrangler/state",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "bunx --bun vite build --mode typecheck",
    "lint": "oxlint --type-aware --type-check src/",
    "lint:fix": "oxlint --type-aware --fix src/",
    "format": "oxfmt src/ --write",
    "format:check": "oxfmt src/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "db:diff": "atlas migrate diff --env local",
    "db:apply": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260118.0",
    "@hono/standard-validator": "^0.2.2",
    "@inspirehub/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.34",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@types/json-schema": "^7.0.15",
    "arktype": "^2.1.29",
    "hono": "^4.11.4",
    "hono-openapi": "^1.1.2",
    "kysely": "^0.28.10",
    "kysely-d1": "^0.4.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.2",
    "wrangler": "^4.17.0"
  }
}
