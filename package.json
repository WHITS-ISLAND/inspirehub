{
  "name": "inspirehub",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "oxlint --type-aware --type-check .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt .",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxc-transform": "^0.108.0",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "oxlint-tsgolint": "^0.11.4",
    "turbo": "^2.7.5",
    "typescript": "^5.7.2"
  }
}
